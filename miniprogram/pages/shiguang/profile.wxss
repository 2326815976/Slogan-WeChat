@import './shared.wxss';

.profile-page { padding-bottom: 176rpx; }
.profile-card { margin-bottom: 0; }
.profile-avatar-row { display: flex; align-items: center; gap: 24rpx; margin: 24rpx 0 28rpx; }
.profile-avatar { width: 160rpx; height: 160rpx; }
button.profile-avatar-action { flex: 1; width: auto; }
.profile-avatar-note { margin-top: 8rpx; }
.profile-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(93, 64, 55, 0.1);
  background: rgba(255, 251, 240, 0.96);
}
.profile-footer button.sg-action { min-height: 84rpx; font-size: 30rpx; }
