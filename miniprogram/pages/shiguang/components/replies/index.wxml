<import src="../message-media.wxml" />
<space-dialog title="絮语回复" busy="{{busy || attachmentBusy}}" bind:close="close">
  <view class="sg-stack">
    <view wx:if="{{error}}" class="sg-error">{{error}}</view>
    <view wx:if="{{mediaError && !formOpen}}" class="sg-error">{{mediaError}}</view>
    <view wx:if="{{loaded && !items.length && !formOpen}}" class="sg-muted">还没有回复，写一句回应吧。</view>
    <view wx:for="{{items}}" wx:key="id" class="reply-card">
      <view class="sg-muted">{{item.author}} · {{item.time}}</view>
      <view wx:if="{{item.content}}" class="sg-text">{{item.content}}</view>
      <image wx:if="{{item.imageUrl}}" class="sg-cover" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="{{true}}" bindtap="openAttachment" data-field="image" data-reference="{{item.image}}" aria-label="查看原图" />
      <view wx:if="{{item.audio || item.video}}" class="sg-actions">
        <button wx:if="{{item.audio}}" class="sg-action" bindtap="playAttachment" data-reference="{{item.audio}}">播放音频</button>
        <button wx:if="{{item.video}}" class="sg-action" bindtap="openAttachment" data-field="video" data-reference="{{item.video}}">播放视频</button>
      </view>
      <view wx:if="{{item.createdBy === userId}}" class="sg-row">
        <text class="sg-link" data-id="{{item.id}}" bindtap="edit">编辑</text><text class="sg-link sg-danger" data-id="{{item.id}}" bindtap="remove">删除</text>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="sg-action" disabled="{{busy}}" bindtap="more">更多回复</button>
    <button wx:if="{{!formOpen}}" class="sg-action sg-action--primary" disabled="{{busy}}" bindtap="start">写回复</button>
    <block wx:else>
      <label class="sg-field"><text class="sg-label">{{editing ? '编辑回复' : '写回复'}}</text><textarea class="sg-input sg-area" placeholder="写一句回应" maxlength="2000" value="{{content}}" disabled="{{busy}}" bindinput="input"/></label>
      <template is="message-media" data="{{media, busy, attachmentBusy, recording, uploadOpen, imageUrl, mediaError, selectedAttachment}}" />
      <view class="sg-actions">
        <button class="sg-action" disabled="{{busy || attachmentBusy}}" bindtap="cancel">取消</button>
        <button class="sg-action sg-action--primary" disabled="{{busy || attachmentBusy || (!content && !media.audio && !media.image && !media.video)}}" bindtap="save">{{editing ? '保存回复' : '发送回复'}}</button>
      </view>
    </block>
  </view>
</space-dialog>
