<view class="sg-divider"><view wx:for="{{items}}" wx:key="id" class="sg-divider"><view class="sg-text">{{item.content}}</view><view class="sg-muted">{{item.author}} · {{item.time}}</view><view wx:if="{{item.createdBy === userId}}" class="sg-row"><text class="sg-link" data-id="{{item.id}}" bindtap="edit">编辑回复</text><text class="sg-link sg-danger" data-id="{{item.id}}" bindtap="remove">删除</text></view></view><text wx:if="{{hasMore}}" class="sg-link" bindtap="more">更多回复</text><textarea class="sg-input sg-area" placeholder="写一句回应" maxlength="2000" value="{{content}}" bindinput="input"/><view wx:if="{{error}}" class="sg-error">{{error}}</view><view class="sg-row"><button class="sg-button" disabled="{{busy}}" bindtap="save">{{editing ? '保存回复' : '回复'}}</button><text wx:if="{{editing}}" class="sg-link" bindtap="cancel">取消</text></view></view>
