:host { display: block; min-width: 0; }
.anniversary-card {
  position: relative;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff2d8;
  background-image: radial-gradient(ellipse at 100% 0%, rgba(229, 159, 154, 0.21), transparent 64%), linear-gradient(155deg, #fffaf1, #f5e5ca);
  color: #66462f;
  font-family: var(--font-default);
  box-shadow: inset 0 0 0 1rpx rgba(167, 114, 75, 0.16), 0 8rpx 16rpx rgba(213, 173, 111, 0.1);
}
.anniversary-entry {
  position: absolute;
  right: 20rpx;
  bottom: 0;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0 14rpx;
  color: #78573e;
  font-size: 22rpx;
  line-height: 1.5;
}
.anniversary-arrow { font-size: 30rpx; line-height: 1; }
/* 天数独立占据视觉中心；底部预留管理入口。 */
.anniversary-swiper { position: absolute; top: 16rpx; left: 0; width: 100%; height: calc(100% - 69rpx); }
.anniversary-slide {
  height: 100%;
  padding: 0 24rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  text-align: center;
}
/* 名称与计时说明作为完整标题，四层内容均匀排布，避免集中挤在中间。 */
.anniversary-heading {
  display: block;
  flex: none;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}
.anniversary-number {
  flex: none;
  color: #5b3d28;
  font-family: var(--font-default, "YouYuan", "Microsoft YaHei", sans-serif);
  font-size: 100rpx;
  font-weight: 600;
  line-height: 112rpx;
  font-variant-numeric: lining-nums tabular-nums;
}
.anniversary-number--wide { font-size: 84rpx; line-height: 92rpx; }
.anniversary-number--medium { font-size: 70rpx; line-height: 76rpx; }
.anniversary-number--compact { font-size: 50rpx; line-height: 54rpx; }
.anniversary-unit { display: flex; flex: none; align-items: center; gap: 14rpx; width: 88%; color: #8d654a; font-size: 20rpx; line-height: 24rpx; }
.anniversary-rule { flex: 1; border-bottom: 4rpx dotted rgba(141, 101, 74, 0.2); }
.anniversary-date { flex: none; color: #8d654a; font-size: 22rpx; line-height: 28rpx; }
.anniversary-empty {
  position: absolute;
  top: 16rpx;
  right: 0;
  bottom: 53rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.anniversary-empty__icon { width: 80rpx; height: 80rpx; }
.anniversary-pressed { opacity: 0.7; }
