:host { display: block; min-width: 0; }
.anniversary-card {
  position: relative;
  padding-top: var(--space-overview-ratio, 100%);
  overflow: hidden;
  border-radius: 36rpx;
  background:
    radial-gradient(ellipse 58% 47% at 28% 118%, rgba(249, 211, 228, 0.53) 99%, transparent 100%),
    radial-gradient(ellipse 70% 59% at 110% 118%, rgba(244, 197, 218, 0.52) 99%, transparent 100%),
    linear-gradient(145deg, #fff9fc 15%, #fcecf3);
  color: #71364e;
  font-family: var(--font-default);
  box-shadow: 0 10rpx 22rpx rgba(162, 78, 116, 0.14);
}
.anniversary-flourish {
  position: absolute;
  right: 5%;
  bottom: 16%;
  width: 40%;
  height: 12%;
  opacity: 0.68;
  pointer-events: none;
}
.anniversary-flourish__heart {
  position: absolute;
  top: 0;
  right: 5%;
  width: 30%;
  height: 80%;
  filter: hue-rotate(-60deg) saturate(2);
  transform: rotate(11deg);
}
.anniversary-footer {
  position: absolute;
  right: 16rpx;
  bottom: 0;
  left: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 14rpx;
  color: #7c4560;
  font-size: 22rpx;
  line-height: 28rpx;
}
.anniversary-date { display: flex; flex: 1; align-items: center; gap: 6rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }
.anniversary-date__icon { flex: none; width: 24rpx; height: 24rpx; filter: hue-rotate(-60deg); }
.anniversary-date::after { content: ''; flex: none; width: 2rpx; height: 22rpx; margin: 0 auto; background: currentColor; opacity: 0.55; }
.anniversary-entry { display: flex; flex: none; align-items: center; gap: 6rpx; margin-left: auto; padding: 4rpx 10rpx; white-space: nowrap; }
.anniversary-arrow { font-size: 30rpx; line-height: 1; }
.anniversary-swiper { position: absolute; top: 0; left: 0; width: 100%; height: calc(100% - 52rpx); }
.anniversary-slide {
  height: 100%;
  padding: var(--space-overview-title-inset, 16rpx 20rpx) 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
}
.anniversary-heading {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
}
.anniversary-heading-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  min-width: 0;
  overflow: hidden;
  word-break: break-all;
  font: var(--space-overview-title-font, 700 26rpx/36rpx var(--font-default));
}
.anniversary-heading-decoration {
  display: flex;
  flex: 1 0 auto;
  align-items: center;
  gap: 8rpx;
  max-width: 94rpx;
  color: #c57398;
  font: 400 18rpx/1 Arial, sans-serif;
}
.anniversary-heading-decoration:last-child { flex-direction: row-reverse; }
.anniversary-heading-decoration::before { content: ''; flex: 1; height: 2rpx; background: #ecc1d5; }
.anniversary-count {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  gap: var(--space-overview-count-gap, 14rpx);
  padding-top: var(--space-overview-count-gap, 10rpx);
}
.anniversary-caption {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #f8dce9;
  color: #7c4560;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
}
.anniversary-unit { color: #7c4560; font-size: 30rpx; font-weight: 600; line-height: 1; }
.anniversary-value {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin: auto 0;
  transform: translateY(-5%);
}
.anniversary-value--accent::before,
.anniversary-value--accent::after {
  position: absolute;
  right: calc(100% + 8rpx);
  width: 17rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #e3a1bf;
  content: '';
}
.anniversary-value--accent::before { top: 24%; transform: rotate(29deg); }
.anniversary-value--accent::after { top: 43%; transform: rotate(-12deg); }
.anniversary-number {
  flex: none;
  color: #71364e;
  font-family: var(--font-default, "YouYuan", "Microsoft YaHei", sans-serif);
  font-size: var(--space-overview-number-size, 108rpx);
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: lining-nums tabular-nums;
  text-shadow: 2rpx 4rpx 4rpx rgba(156, 66, 108, 0.19);
}
.anniversary-number--wide { font-size: 72rpx; }
.anniversary-number--medium { font-size: 60rpx; }
.anniversary-number--compact { font-size: 44rpx; }
.anniversary-empty {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 53rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.anniversary-empty__title { position: absolute; top: 0; padding: var(--space-overview-title-inset, 16rpx 20rpx) 0; }
.anniversary-empty__icon { width: 80rpx; height: 80rpx; }
.anniversary-pressed { opacity: 0.7; }
