:host { display: block; min-width: 0; }
.anniversary-card {
  position: relative;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff2d8;
  color: #66462f;
  font-family: var(--font-default);
  box-shadow: 0 8rpx 16rpx rgba(213, 173, 111, 0.1);
}
.anniversary-header {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  font-size: 26rpx;
  line-height: 36rpx;
}
.anniversary-label { font-weight: 700; }
.anniversary-entry {
  position: absolute;
  right: 20rpx;
  bottom: 0;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 18rpx;
  color: #78573e;
  font-size: 22rpx;
  line-height: 1.5;
}
.anniversary-arrow { font-size: 30rpx; line-height: 1; }
/* 顶部类型与底部入口固定，中间区域供日期轮播和空状态共用。 */
.anniversary-swiper { position: absolute; top: 60rpx; left: 0; width: 100%; height: calc(100% - 123rpx); }
.anniversary-slide {
  height: 100%;
  padding: 0 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  text-align: center;
}
.anniversary-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  max-width: 100%;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}
.anniversary-caption { color: #8d654a; font-size: 22rpx; line-height: 1.3; }
.anniversary-count { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; }
.anniversary-number { font-size: 64rpx; font-weight: 700; line-height: 1.05; font-variant-numeric: tabular-nums; }
.anniversary-number--compact { font-size: 46rpx; }
.anniversary-unit { font-size: 22rpx; }
.anniversary-date { color: #8d654a; font-size: 20rpx; line-height: 1.4; }
.anniversary-empty {
  position: absolute;
  top: 60rpx;
  right: 0;
  bottom: 63rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.anniversary-empty__icon { width: 80rpx; height: 80rpx; }
.anniversary-pressed { opacity: 0.7; }
