<view class="anniversary-card">
  <view class="anniversary-header">
    <text class="anniversary-label">{{slides[current].typeLabel || '纪念日'}}</text>
  </view>
  <swiper wx:if="{{slides.length}}" class="anniversary-swiper" current="{{current}}" autoplay="{{active && slides.length > 1}}" interval="{{5000}}" duration="{{400}}" circular="{{slides.length > 1}}" indicator-dots="{{slides.length > 1}}" indicator-color="#decbb0" indicator-active-color="#8d654a" bindchange="change">
    <swiper-item wx:for="{{slides}}" wx:key="id">
      <view class="anniversary-slide">
        <text class="anniversary-name">{{item.name}}</text>
        <view class="anniversary-count"><text class="anniversary-caption">{{item.caption}}</text><text class="anniversary-number {{item.compact ? 'anniversary-number--compact' : ''}}">{{item.days}}</text><text class="anniversary-unit">天</text></view>
        <text class="anniversary-date">{{item.date}}</text>
      </view>
    </swiper-item>
  </swiper>
  <view wx:else class="anniversary-empty" role="button" aria-label="进入纪念日管理" bindtap="manage" hover-class="anniversary-pressed">
    <image class="anniversary-empty__icon" src="/pages/shiguang/images/anniversary.svg" mode="aspectFit" />
  </view>
  <view class="anniversary-entry" role="button" aria-label="进入纪念日和倒数日管理" bindtap="manage" hover-class="anniversary-pressed">
    <text>点击进入</text><text class="anniversary-arrow">›</text>
  </view>
</view>
