<view class="anniversary-card" role="button" aria-label="进入纪念日和倒数日管理" bindtap="manage" hover-class="anniversary-pressed">
  <view class="anniversary-flourish">
    <image class="anniversary-flourish__heart" src="/images/icons/heart-outline-muted.svg" mode="aspectFit" />
  </view>
  <swiper wx:if="{{slides.length}}" class="anniversary-swiper" current="{{current}}" duration="{{400}}" circular="{{slides.length > 1}}" style="{{touchDisabled ? 'pointer-events: none;' : ''}}" bindchange="change">
    <swiper-item wx:for="{{slides}}" wx:key="id">
      <view class="anniversary-slide" catchtap="manage">
        <view class="anniversary-heading">
          <view class="anniversary-heading-decoration"><text>♥</text></view>
          <text class="anniversary-heading-text">{{item.name}}</text>
          <view class="anniversary-heading-decoration"><text>♥</text></view>
        </view>
        <view class="anniversary-count">
          <text class="anniversary-caption">{{item.caption}}</text>
          <view class="anniversary-value {{100 > item.days ? 'anniversary-value--accent' : ''}}">
            <text class="anniversary-number {{item.compact ? 'anniversary-number--compact' : item.days >= 10000 ? 'anniversary-number--medium' : item.days >= 1000 ? 'anniversary-number--wide' : ''}}">{{item.days}}</text>
            <text class="anniversary-unit">天</text>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>
  <view wx:else class="anniversary-empty">
    <text class="anniversary-heading-text anniversary-empty__title">纪念日</text>
    <image class="anniversary-empty__icon" src="/pages/shiguang/images/anniversary.svg" mode="aspectFit" />
  </view>
  <view class="anniversary-footer">
    <view wx:if="{{slides.length}}" class="anniversary-date">
      <image class="anniversary-date__icon" src="/images/icons/calendar-brown.svg" mode="aspectFit" />
      <text>{{slides[current].date}}</text>
    </view>
    <view class="anniversary-entry"><text>点击进入</text><text class="anniversary-arrow">›</text></view>
  </view>
</view>
