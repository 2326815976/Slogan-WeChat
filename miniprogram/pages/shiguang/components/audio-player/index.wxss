.audio-player {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 14rpx 28rpx 14rpx 14rpx;
  border: 1rpx solid #ecd8c5;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fff5e9, #f8eadc);
  color: #8d6047;
  line-height: 1;
}

.audio-player::after { border: 0; }
.audio-player[disabled] { opacity: .62; }
.audio-player--playing { background: linear-gradient(180deg, #fff1df, #f6e3d1); }
.audio-player--without-control { padding-left: 28rpx; }
.audio-player--embedded {
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.audio-player__control {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #a96f4b;
  box-shadow: 0 6rpx 14rpx rgba(142, 93, 62, 0.18);
}

.audio-player__play {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.audio-player__pause {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 28rpx;
}

.audio-player__pause view {
  width: 7rpx;
  height: 100%;
  border-radius: 3rpx;
  background: #fff;
}

.audio-player__wave {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 56rpx;
  overflow: hidden;
}
.audio-player__wave-layer {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  opacity: 0.3;
}
.audio-player__wave-layer--active {
  opacity: 1;
  transition: clip-path 240ms linear;
}

.audio-player__bar {
  width: 4rpx;
  flex: 1;
  min-width: 2rpx;
  max-width: 5rpx;
  border-radius: 999rpx;
  background: #a87959;
}

.audio-player__duration {
  flex: none;
  min-width: 66rpx;
  color: #8d6b58;
  font-size: 21rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
