<view class="dialog">
  <view class="dialog__backdrop" bindtap="close" catchtouchmove="keepBackgroundStill" />
  <view class="dialog__panel" role="dialog" aria-label="{{title}}">
    <view class="dialog__header">
      <view class="dialog__heading">
        <text class="dialog__title">{{title}}</text>
        <text wx:if="{{subtitle}}" class="dialog__subtitle">{{subtitle}}</text>
      </view>
      <view wx:if="{{!busy}}" class="dialog__close" role="button" aria-label="关闭" bindtap="close" hover-class="dialog__close--pressed">×</view>
    </view>
    <view class="dialog__body"><slot /></view>
  </view>
</view>
