.sg-optional {
  overflow: hidden;
  border: 2rpx dashed #e6d3b9;
  border-radius: 24rpx;
  background: #fffaf1;
}
button.sg-optional-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  background: transparent;
  color: #674a37;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: left;
}
button.sg-optional-toggle::after { border: 0; }
.sg-optional-label { flex: 1; min-width: 0; }
.sg-optional-state { display: flex; flex: none; align-items: center; gap: 12rpx; color: #795f56; }
.sg-optional-filled {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f1e6d7;
  color: #806454;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.4;
}
.sg-optional-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) translate(-3rpx, -3rpx);
  transition: transform .18s ease;
}
.sg-optional--open .sg-optional-chevron { transform: rotate(225deg) translate(-3rpx, -3rpx); }
.sg-optional-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 22rpx;
  border-top: 2rpx dashed #e6d3b9;
  background: #fffdf8;
}
.sg-optional--attachments { overflow: visible; border: 0; border-radius: 0; background: transparent; }
.sg-optional--attachments .sg-optional-toggle {
  min-height: 78rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid #efe2d8;
}
.sg-optional--attachments .sg-optional-filled { background: #fff3dc; color: #8c684c; }
.sg-optional--attachments .sg-optional-content {
  gap: 0;
  padding: 18rpx 0 0;
  border-top: 0;
  background: transparent;
}
