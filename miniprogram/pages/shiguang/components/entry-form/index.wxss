@import '../../shared.wxss';

.whisper-editor { display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.whisper-editor__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 2rpx;
}
.whisper-editor__head text:first-child { color: #5f4538; font-size: 24rpx; font-weight: 700; line-height: 1.4; }
.whisper-editor__head text:last-child { flex: none; color: #a08a7e; font-size: 19rpx; line-height: 1.4; }
.whisper-editor .whisper-editor__input {
  box-sizing: border-box;
  height: 300rpx;
  min-height: 300rpx;
  margin: 0;
  padding: 24rpx 26rpx;
  border: 2rpx solid #eadcd4;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fffdfa, #fffaf6);
  line-height: 1.75;
  box-shadow: inset 0 2rpx 4rpx rgba(93, 64, 55, 0.03);
}
.whisper-topic-preview { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; padding: 2rpx 2rpx 0; }
.whisper-topic-preview__label { flex: none; color: #a08a7e; font-size: 19rpx; line-height: 1.5; }
.whisper-topic-preview__tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #edf4fc;
  color: #4e79a7;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.5;
}
.entry-actions--whisper {
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr);
  gap: 16rpx;
  padding-top: 4rpx;
}
.entry-actions--whisper button { min-height: 84rpx; border-radius: 22rpx; }
.entry-actions--whisper button:first-child { border: 1rpx solid #eadccf; background: #fffdfa; }
