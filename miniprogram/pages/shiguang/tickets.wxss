@import './shared.wxss';
.offering-image{display:block;width:100%;height:300rpx;margin:12rpx 0;border-radius:16rpx;background:#fff5d9}
.wheel{width:420rpx;height:420rpx;border-radius:50%;border:12rpx solid #FFF5D9;outline:3rpx solid #5D4037;box-shadow:6rpx 8rpx 0 #5d403726;position:relative;margin:32rpx auto;transition:transform 2.5s cubic-bezier(.15,.7,.1,1)}.wheel-label{position:absolute;top:50%;left:50%;font-size:22rpx;max-width:150rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transform-origin:0 0}.pointer{position:relative;z-index:1;color:#B45345;font-size:40rpx;margin-bottom:-60rpx}
