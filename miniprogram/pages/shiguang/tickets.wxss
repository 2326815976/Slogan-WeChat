@import './shared.wxss';
.wheel{width:440rpx;height:440rpx;border-radius:50%;border:12rpx solid white;box-shadow:0 8rpx 32rpx #5d403722;position:relative;margin:20rpx auto;transition:transform 2.5s cubic-bezier(.15,.7,.1,1)}.wheel-label{position:absolute;top:50%;left:50%;font-size:22rpx;max-width:170rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transform-origin:0 0}.pointer{position:relative;z-index:1;color:#B45345;font-size:40rpx;margin-bottom:-60rpx}
