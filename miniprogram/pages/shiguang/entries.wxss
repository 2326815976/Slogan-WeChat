@import './shared.wxss';

.entries-content { padding-bottom: 16rpx; }
.entries-toolbar { display: grid; gap: 12rpx; margin-bottom: 24rpx; }
.entries-toolbar > button { min-height: 84rpx; font-size: 29rpx; }
.entries-filters { display: flex; gap: 12rpx; }
.entries-date-picker { flex: 1; min-width: 0; }
.entries-date-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid #e6d3b9;
  border-radius: 20rpx;
  background: #fffdf8;
  color: #674a37;
  font-size: 26rpx;
}
.entries-filter-arrow { flex: none; width: 22rpx; height: 22rpx; transform: rotate(90deg); }
button.entries-clear { width: auto; flex: none; padding-inline: 16rpx; }
.entries-empty { padding-block: 40rpx; }
.entries-content > .sg-list-stack { margin-bottom: 24rpx; }
.entries-anniversary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entries-anniversary-grid > .sg-list-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}
.entries-anniversary { display: grid; gap: 6rpx; padding: 16rpx; border-radius: 18rpx; background: #fceef0; }
.entries-count { display: grid; gap: 4rpx; color: #795f56; font-size: 23rpx; }
.entries-count__value { display: flex; align-items: baseline; gap: 6rpx; max-width: 100%; }
.entries-count__number {
  min-width: 0;
  overflow-wrap: anywhere;
  color: #5d4037;
  font: 700 42rpx/1.15 Georgia, serif;
}
.entries-cover { display: block; background: #f8f1ed; border-radius: 18rpx; }
.entries-anniversary-grid .sg-list-footer { margin-top: auto; }
.entries-anniversary-grid button.sg-list-action { padding-inline: 14rpx; }
.entries-wish { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; padding: 20rpx 22rpx; }
.entries-wish-heading { display: flex; flex: 1 1 230rpx; align-items: center; min-width: 0; gap: 8rpx; }
.entries-wish .sg-list-title { font-size: 28rpx; white-space: pre-wrap; }
.entries-wish-side { display: grid; gap: 4rpx; max-width: 100%; margin-left: auto; text-align: right; }
button.entries-wish-check { display: flex; flex: none; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.entries-wish-check::after { border: 0; }
button.entries-wish-check[disabled] { background: transparent; opacity: .55; }
.entries-wish-check__mark { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 2rpx solid #b99a8a; border-radius: 50%; font-size: 24rpx; line-height: 1; }
.entries-wish--fulfilled .entries-wish-check__mark { border-color: #e48ca0; background: #e48ca0; color: #fff; }
.entries-wish--fulfilled .sg-list-title { color: #795f56; text-decoration: line-through; }
.entries-whisper { gap: 10rpx; padding: 20rpx 22rpx; }
.entries-whisper .sg-list-footer { padding-top: 4rpx; }
