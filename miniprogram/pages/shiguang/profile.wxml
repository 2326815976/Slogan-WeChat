<secondary-page-shell title="我的空间资料" fallbackRoute="/pages/shiguang/index"><view class="sg-content"><view wx:if="{{error}}" class="sg-error">{{error}}</view><view class="sg-card"><view class="sg-muted">名称与头像仅用于拾光空间</view><view class="sg-label">名称</view><input class="sg-input" value="{{name}}" maxlength="100" bindinput="nameInput"/><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="sg-avatar" mode="aspectFill"/><button class="sg-button" disabled="{{busy}}" bindtap="avatar">更换头像</button><button class="sg-button" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存</button></view></view></secondary-page-shell>
