<secondary-page-shell title="编辑空间资料" fallbackRoute="/pages/shiguang/index">
  <view class="sg-content profile-page">
    <view wx:if="{{error}}" class="sg-error">{{error}}</view>
    <view wx:if="{{profileReady}}" class="sg-card profile-card">
      <view class="sg-title">我的资料</view>
      <view class="sg-muted">名称与头像仅用于拾光空间</view>
      <view class="profile-avatar-row">
        <image class="sg-avatar profile-avatar" src="{{avatarUrl || '/images/icons/user-brown.svg'}}" mode="aspectFill" />
        <button class="sg-action profile-avatar-action" disabled="{{busy}}" bindtap="changeAvatar">{{avatar ? '更换头像' : '选择头像'}}</button>
      </view>
      <label class="sg-field">
        <text class="sg-label">名称</text>
        <input class="sg-input" placeholder="请输入昵称" value="{{name}}" maxlength="100" disabled="{{busy}}" bindinput="nameInput" />
      </label>
      <view class="sg-muted profile-avatar-note">头像会自动压缩后保存</view>
    </view>
    <view wx:elif="{{loading}}" class="sg-card sg-center sg-muted">正在加载空间资料…</view>
    <view wx:if="{{profileReady}}" class="profile-footer">
      <button class="sg-action sg-action--primary" loading="{{busy}}" disabled="{{busy || !name}}" bindtap="save">保存资料</button>
    </view>
  </view>
</secondary-page-shell>
