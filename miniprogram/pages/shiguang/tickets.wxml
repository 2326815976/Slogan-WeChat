<template name="offeringEditor">
  <view class="sg-stack offering-editor">
    <label class="sg-field"><text class="sg-label">名称</text><input class="sg-input" maxlength="100" value="{{name}}" disabled="{{busy}}" data-key="name" bindinput="input"/></label>
    <label class="sg-field"><text class="sg-label">{{contentOptional ? '内容（选填）' : '内容'}}</text><textarea class="sg-input sg-area" maxlength="5000" value="{{content}}" disabled="{{busy}}" data-key="content" bindinput="input"/></label>
    <view class="sg-field">
      <view class="sg-label">图片（选填）</view>
      <image wx:if="{{imageUrl}}" class="offering-image" src="{{imageUrl}}" mode="aspectFit"/>
      <view wx:if="{{image}}" class="sg-actions">
        <button class="sg-action" disabled="{{busy}}" bindtap="chooseImage">更换图片</button>
        <button class="sg-action" disabled="{{busy}}" bindtap="clearImage">移除图片</button>
      </view>
      <button wx:else class="sg-action" disabled="{{busy}}" bindtap="chooseImage">上传图片</button>
    </view>
  </view>
</template>

<template name="offeringDetails">
  <view class="ticket-name">{{item.name}}</view>
  <image wx:if="{{item.imageUrl}}" class="offering-image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="{{true}}"/>
  <view wx:if="{{item.content}}" class="sg-text">{{item.content}}</view>
  <view class="sg-muted">{{item.provider}} 提供 · {{item.drawerId ? '抽奖人 ' : '拟赠给 '}}{{item.recipient}} · {{item.time}}</view>
</template>

<template name="ticketFeedback">
  <view wx:if="{{!form && error}}" class="sg-error">{{error}}</view>
  <view wx:if="{{message}}" class="sg-note tickets-message">{{message}}</view>
</template>

<secondary-page-shell title="心意奖券" use-scroll-view="{{false}}" shell-class="tickets-shell" content-class="tickets-shell-content" fallbackRoute="/pages/shiguang/index">
  <view class="tickets-body">
    <view class="ticket-tabs" aria-label="心意奖券分类">
      <button wx:for="{{sections}}" wx:key="id" class="ticket-tab {{section === item.id ? 'ticket-tab--active' : ''}}"
        disabled="{{busy}}" data-section="{{item.id}}" bindtap="selectSection" aria-label="{{item.label}}{{section === item.id ? '，当前选中' : ''}}">
        {{item.label}}
      </button>
    </view>
    <view wx:if="{{!loaded}}" class="tickets-loading">
      <template is="ticketFeedback" data="{{form, error, message}}"/>
      <view wx:if="{{!error}}" class="sg-muted sg-center">正在加载心意奖券…</view>
    </view>
    <block wx:else>
      <scroll-view wx:if="{{section === 'wheel'}}" class="tickets-scroll" scroll-y="{{!form}}" show-scrollbar="{{false}}">
        <view class="tickets-content">
          <template is="ticketFeedback" data="{{form, error, message}}"/>
          <view class="sg-card sg-center tickets-wheel-card">
            <view class="sg-title">{{partnerName}} 的心意转盘</view>
            <view class="sg-chip">剩余 {{balance}} 次</view>
            <view wx:if="{{pool.length}}" class="wheel-stage">
              <view class="wheel" style="background:{{gradient}};transform:rotate({{angle}}deg)">
                <text class="wheel-label" wx:for="{{pool}}" wx:key="id" style="{{item.labelStyle}}">{{item.name}}</text>
              </view>
              <view class="wheel-pointer" />
              <view class="wheel-hub" />
            </view>
            <button class="sg-action sg-action--primary tickets-draw" disabled="{{busy || (!retryDraw && (!balance || !canDraw))}}" bindtap="draw">{{retryDraw ? '确认上次抽奖' : '转动心意'}}</button>
            <view class="sg-muted">{{!pool.length ? '对方还没有准备奖项' : !balance ? '等待对方赠送抽奖机会' : '每个奖项机会相同，每次必中奖'}}</view>
          </view>
          <view class="sg-card ticket-section-heading">
            <view class="ticket-section-heading__main">
              <view class="sg-title">赠送抽奖次数</view>
              <view class="sg-muted">{{partnerName}} 可用 {{partnerBalance}} 次</view>
            </view>
            <button class="sg-action ticket-section-button" disabled="{{busy || !summary}}" bindtap="openGrant">赠送次数</button>
          </view>
          <view class="sg-card">
            <view class="sg-title">次数赠送记录</view>
            <view wx:if="{{!grants.length}}" class="sg-muted">还没有赠送记录</view>
            <view wx:for="{{grants}}" wx:key="id" class="sg-muted">{{item.giver}} 给予 {{item.receiver}} {{item.amount}} 次 · {{item.time}}</view>
            <text wx:if="{{grantMore}}" class="sg-link" data-resource="grants" bindtap="more">更多记录</text>
          </view>
          <view class="sg-card">
            <view class="ticket-section-heading">
              <view class="ticket-section-heading__main">
                <view class="sg-title">我提供的奖池</view>
                <view class="sg-muted">供 {{partnerName}} 抽取</view>
              </view>
              <button class="sg-action ticket-section-button" data-mode="prizes" disabled="{{busy}}" bindtap="openForm">新增奖项</button>
            </view>
            <view wx:if="{{!own.length}}" class="sg-muted ticket-empty">还没有提供奖项</view>
            <view wx:for="{{own}}" wx:key="id" class="sg-divider">
              <template is="offeringDetails" data="{{item: item}}"/>
              <view class="sg-row">
                <text class="sg-link" data-mode="prizes" data-id="{{item.id}}" bindtap="openForm">编辑</text>
                <text class="sg-link sg-danger" data-mode="prizes" data-id="{{item.id}}" bindtap="remove">删除</text>
              </view>
            </view>
          </view>
          <view wx:if="{{pool.length}}" class="sg-card">
            <view class="sg-title">对方提供的奖项</view>
            <view wx:for="{{pool}}" wx:key="id" class="sg-divider"><template is="offeringDetails" data="{{item: item}}"/></view>
          </view>
        </view>
      </scroll-view>
      <scroll-view wx:else class="tickets-scroll" scroll-y="{{!form}}" show-scrollbar="{{false}}">
        <view class="tickets-content">
          <template is="ticketFeedback" data="{{form, error, message}}"/>
          <view class="sg-card">
            <view class="ticket-section-heading">
              <view class="ticket-section-heading__main"><view class="sg-title">待赠卡券</view></view>
              <button class="sg-action sg-action--primary ticket-section-button" data-mode="gift-cards" disabled="{{busy}}" bindtap="openForm">创建卡券</button>
            </view>
            <view wx:if="{{!cards.length}}" class="sg-muted ticket-empty">还没有待赠卡券，先创建一张吧。</view>
            <view wx:for="{{cards}}" wx:key="id" class="sg-divider">
              <template is="offeringDetails" data="{{item: item}}"/>
              <view wx:if="{{item.own}}" class="sg-row">
                <button class="sg-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="sendCard">赠送给对方</button>
                <text class="sg-link" data-mode="gift-cards" data-id="{{item.id}}" bindtap="openForm">编辑</text>
                <text class="sg-link sg-danger" data-mode="gift-cards" data-id="{{item.id}}" bindtap="remove">删除</text>
              </view>
            </view>
          </view>
          <view class="sg-card">
            <view class="sg-title">送出与获得</view>
            <view wx:if="{{!tickets.length}}" class="sg-muted">还没有卡券记录</view>
            <view wx:for="{{tickets}}" wx:key="id" class="sg-divider">
              <view class="sg-row sg-between"><text class="ticket-name">{{item.name}}</text><text class="sg-chip {{item.status === 'used' ? 'ticket-chip--used' : ''}}">{{item.status === 'used' ? '已使用' : '待使用'}}</text></view>
              <image wx:if="{{item.imageUrl}}" class="offering-image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="{{true}}"/>
              <view wx:if="{{item.content}}" class="sg-text">{{item.content}}</view>
              <view class="sg-muted">{{item.sourceLabel}}</view>
              <view class="sg-muted">{{item.sentGift ? '送出' : '获得'}}：{{item.time}}</view>
              <view wx:if="{{item.usedTime}}" class="sg-muted">使用：{{item.usedTime}}</view>
              <button wx:if="{{item.canRedeem}}" class="sg-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="redeem">已兑现，标记使用</button>
            </view>
            <text wx:if="{{ticketMore}}" class="sg-link" data-resource="tickets" bindtap="more">更多奖券</text>
          </view>

        </view>
      </scroll-view>
    </block>
  </view>
</secondary-page-shell>
<space-dialog wx:if="{{form}}" title="{{formTitle}}" subtitle="{{form === 'grant' ? partnerName + ' 还有 ' + partnerBalance + ' 次抽奖机会' : ''}}" busy="{{busy}}" bind:close="cancel">
  <view class="sg-stack">
    <label wx:if="{{form === 'grant'}}" class="sg-field"><text class="sg-label">赠送次数</text><input type="number" class="sg-input" value="{{amount}}" disabled="{{busy}}" data-key="amount" bindinput="input"/></label>
    <template wx:else is="offeringEditor" data="{{name, content, image, imageUrl, busy, contentOptional: form === 'prizes'}}"/>
    <view wx:if="{{error}}" class="sg-error">{{error}}</view>
    <view class="sg-actions">
      <button class="sg-action" disabled="{{busy}}" bindtap="cancel">取消</button>
      <button wx:if="{{form === 'grant'}}" class="sg-action sg-action--primary" loading="{{busy}}" disabled="{{busy || !amount}}" bindtap="grant">确认赠送</button>
      <button wx:else class="sg-action sg-action--primary" disabled="{{busy || !name || (form === 'gift-cards' && !content)}}" bindtap="save">保存</button>
    </view>
  </view>
</space-dialog>
