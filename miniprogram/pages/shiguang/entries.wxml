<secondary-page-shell title="{{title}}" fallbackRoute="/pages/shiguang/index"><view class="sg-content">
  <view wx:if="{{error}}" class="sg-error">{{error}}</view><button wx:if="{{summary}}" class="sg-button" bindtap="add">{{kind === 'mood' ? '记录 / 编辑今日心情' : '新增记录'}}</button>
  <view wx:if="{{kind === 'mood'}}" class="sg-row"><picker mode="date" value="{{date}}" bindchange="date"><view class="sg-link">{{date || '按日期查看'}}</view></picker><text class="sg-link" bindtap="clearDate">全部历史</text></view>
  <entry-form wx:if="{{formOpen}}" kind="{{kind}}" entry="{{editing}}" bind:saved="saved" bind:cancel="cancel"/>
  <view wx:if="{{loaded && !items.length}}" class="sg-card sg-center">这里还没有记录，写下我们的第一笔吧。</view>
  <view wx:for="{{items}}" wx:key="id" class="sg-card"><view class="sg-title">{{item.payload.name || item.payload.title || item.payload.mood || '一个愿望'}}</view><view wx:if="{{kind === 'anniversary'}}"><view class="sg-title">{{item.payload.direction === 'down' ? '距离约定' : '一起走过'}} {{item.days}} 天</view><view class="sg-muted">{{item.payload.date}} · {{item.payload.direction === 'down' ? '倒数' : '正数'}}</view></view><view wx:if="{{kind === 'wish'}}" class="sg-chip">{{item.payload.status === 'fulfilled' ? '已实现' : '未实现'}}</view><view wx:if="{{item.moodDate}}" class="sg-muted">{{item.moodDate}}</view><image wx:if="{{item.imageUrl}}" class="sg-cover" src="{{item.imageUrl}}" mode="aspectFit"/><view wx:if="{{item.payload.location}}" class="sg-muted">{{item.payload.location}}</view><view class="sg-text">{{item.payload.content || item.payload.description}}</view><button wx:if="{{item.payload.audio}}" class="sg-button" data-id="{{item.id}}" bindtap="play">播放录音</button><view class="sg-muted">{{item.author}} · {{item.time}}</view><view class="sg-row"><block wx:if="{{item.canManage}}"><text class="sg-link" data-id="{{item.id}}" bindtap="edit">编辑</text><text class="sg-link sg-danger" data-id="{{item.id}}" bindtap="remove">删除</text></block><text wx:if="{{kind === 'whisper'}}" class="sg-link" data-id="{{item.id}}" bindtap="replies">{{replyId === item.id ? '收起回复' : '查看 / 写回复'}}</text></view><space-replies wx:if="{{replyId === item.id}}" entryId="{{item.id}}" userId="{{summary.userId}}" members="{{summary.space.members}}"/></view>
  <button wx:if="{{hasMore}}" class="sg-button" bindtap="more">更多记录</button>
</view></secondary-page-shell>
