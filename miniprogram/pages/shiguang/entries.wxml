<secondary-page-shell title="{{title}}" scroll-y="{{!formOpen && !replyId}}" fallbackRoute="/pages/shiguang/index">
  <view class="entries-content">
    <view wx:if="{{error}}" class="sg-error">{{error}}</view>
    <view wx:if="{{summary}}" class="entries-toolbar">
      <button class="sg-action sg-action--primary" bindtap="add">{{actionLabel}}</button>
      <view wx:if="{{kind === 'mood'}}" class="entries-filters">
        <picker class="entries-date-picker" mode="date" value="{{date || summary.today}}" end="{{summary.today}}" bindchange="changeDate">
          <view class="entries-date-control">
            <text>{{date || '按日期筛选'}}</text>
            <image src="./images/arrow.svg" mode="aspectFit" class="entries-filter-arrow" />
          </view>
        </picker>
        <button wx:if="{{date}}" class="sg-action entries-clear" bindtap="clearDate">查看全部</button>
      </view>
    </view>
    <view wx:if="{{!items.length && !error && (loaded || loading)}}" class="sg-card entries-empty sg-center sg-muted">
      {{loading ? '正在加载记录…' : date ? '这一天没有心情记录。' : emptyLabel}}
    </view>
    <view wx:for="{{items}}" wx:key="id" class="sg-card">
      <view class="entries-heading">
        <view class="sg-title">{{item.payload.name || item.payload.title || item.payload.mood || '一条记录'}}</view>
        <text wx:if="{{kind === 'wish'}}" class="sg-chip {{item.payload.status === 'fulfilled' ? 'entries-chip--fulfilled' : ''}}">{{item.payload.status === 'fulfilled' ? '已实现' : '未实现'}}</text>
      </view>
      <view wx:if="{{kind === 'anniversary'}}" class="entries-anniversary">
        <view class="entries-count">
          <text>{{item.payload.direction === 'down' ? (item.days < 0 ? '已过' : '距离约定') : (item.days < 0 ? '距离这一天' : '一起走过')}}</text>
          <text class="entries-count__number">{{item.days < 0 ? -item.days : item.days}}</text>
          <text>天</text>
        </view>
        <view class="sg-muted">{{item.payload.date}} · {{item.payload.direction === 'down' ? '倒数日' : '纪念日'}}</view>
      </view>
      <view wx:if="{{item.moodDate}}" class="sg-muted">心情日期 {{item.moodDate}}</view>
      <image wx:if="{{item.imageUrl}}" class="sg-cover entries-cover" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="{{true}}"/>
      <view wx:if="{{item.payload.location}}" class="sg-muted">{{item.payload.location}}</view>
      <view wx:if="{{item.payload.content || item.payload.description}}" class="sg-text">{{item.payload.content || item.payload.description}}</view>
      <button wx:if="{{item.payload.audio}}" class="sg-button" data-id="{{item.id}}" bindtap="play">播放录音</button>
      <view class="sg-muted entries-byline">{{item.author || '空间成员'}} · {{item.time}}</view>
      <view wx:if="{{item.canManage || kind === 'whisper'}}" class="entries-actions sg-row">
        <button wx:if="{{kind === 'whisper'}}" class="sg-action entries-action" data-id="{{item.id}}" bindtap="replies">查看与回复</button>
        <block wx:if="{{item.canManage}}">
          <button class="sg-action entries-action" data-id="{{item.id}}" bindtap="edit">编辑</button>
          <button class="sg-action entries-action entries-action--danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">删除</button>
        </block>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="sg-action" loading="{{loading}}" disabled="{{loading}}" bindtap="more">加载更多记录</button>
  </view>
</secondary-page-shell>
<entry-form wx:if="{{formOpen}}" kind="{{kind}}" title="{{title}}" entry="{{editing}}" bind:saved="saved" bind:cancel="cancel"/>
<space-replies wx:if="{{replyId}}" entryId="{{replyId}}" userId="{{summary.userId}}" members="{{summary.space.members}}" bind:close="closeReplies"/>
