@import '../../../styles/shiguang.wxss';
/* 保持与既有专属空间管理一致的封面卡片与胶囊操作区。 */
.sg-admin-toolbar{margin-bottom:28rpx}.sg-admin-toolbar .sg-button{margin-top:24rpx}.sg-admin .sg-card{border:2rpx solid #5d40371f;box-shadow:0 8rpx 28rpx #5d403708}.sg-admin .sg-button{border:2rpx solid #ffc85780;border-radius:999rpx;box-shadow:none}.sg-admin .sg-button:active{transform:scale(.98)}.sg-admin .sg-upload{background:#FFF5D9;border:2rpx dashed #d5ad54}.sg-admin-setting{padding:24rpx 0;margin:12rpx 0;border-bottom:2rpx dashed #5d403726}
.sg-admin-space{padding:0;overflow:hidden}.sg-admin-cover{position:relative;height:300rpx;background:#FFF0D4}.sg-admin-cover image{width:100%;height:100%}.sg-admin-status{position:absolute;top:24rpx;right:24rpx;padding:8rpx 20rpx;border-radius:999rpx;background:#FFFBF0;color:#795548;font-size:24rpx}.sg-admin-status.is-enabled{background:#EAF3DF;color:#46613C}.sg-admin-body{padding:28rpx}.sg-admin-body .sg-title{margin-bottom:4rpx}.sg-admin-id{font-size:22rpx}
.sg-admin-members{margin:28rpx 0;padding:20rpx;border-radius:28rpx;background:#FFFBF0}.sg-admin-member{display:flex;align-items:center;gap:18rpx;margin:12rpx 0}.sg-admin-avatar{width:72rpx;height:72rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#FFF0D4;border-radius:50%;font-size:36rpx;color:#B45345}.sg-admin-member-name{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx;font-size:28rpx;word-break:break-all}.sg-admin-member .sg-link{font-size:22rpx;padding:10rpx 16rpx;min-height:68rpx;background:#fff;flex-shrink:0}
.sg-admin-actions{display:flex;align-items:center;gap:20rpx;margin-top:28rpx;padding-top:24rpx;border-top:2rpx dashed #5d403726}.sg-admin-actions>*{flex:1;margin:0;min-height:84rpx}.sg-admin button.sg-link::after{border:0}.sg-admin-pagination{justify-content:center;font-size:26rpx}.sg-admin-pagination button{margin:0}.sg-admin-pagination button[disabled]{opacity:.4}
