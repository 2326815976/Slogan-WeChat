/* 内容直接沿用后台留白，工具栏与控件复用专属空间管理样式。 */
.sg-admin-panel { color: #5d4037; }
.sg-admin-empty { padding: 64rpx 20rpx; text-align: center; color: #8d6e63; font-size: 24rpx; }
.sg-admin-space { border: 2rpx solid rgba(93,64,55,.12); border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; background: #fff; }
.sg-admin-cover { position: relative; height: 280rpx; background: #fff0d4; }
.sg-admin-cover image { width: 100%; height: 100%; }
.sg-admin-status { position: absolute; top: 20rpx; right: 20rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: #fffbf0; color: #795548; font-size: 22rpx; }
.sg-admin-status.is-enabled { background: #eaf3df; color: #46613c; }
.sg-admin-body { padding: 24rpx; }
.sg-admin-title { font-size: 30rpx; font-weight: 700; word-break: break-all; }
.sg-admin-id { font-size: 20rpx; color: #8d6e63; margin-top: 8rpx; word-break: break-all; }
.sg-admin-members { margin: 24rpx 0; padding: 16rpx; border-radius: 20rpx; background: #fffbf0; }
.sg-admin-member { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.sg-admin-member-name { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; font-size: 26rpx; word-break: break-all; }
.sg-admin-muted { color: #8d6e63; font-size: 22rpx; }
.sg-admin-actions { display: flex; gap: 16rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx dashed rgba(93,64,55,.15); }
.sg-admin-actions .booking-pill-btn { flex: 1; }
/* 原生 button 默认外边距和边框不会跨组件继承，显式归零。 */
.booking-pill-btn, .booking-page-btn, .booking-modal__submit, .booking-modal__close { margin: 0; box-sizing: border-box; }
.booking-pill-btn::after, .booking-page-btn::after, .booking-modal__submit::after, .booking-modal__close::after { border: 0; }
/* 微信原生按钮带默认最小宽度和禁用配色，组件内显式沿用后台控件规格。 */
.sg-admin-panel .booking-pill-btn, .sg-admin-panel .booking-page-btn, .sg-admin-dialog .booking-pill-btn { width: auto !important; min-width: 0 !important; padding: 0 18rpx !important; line-height: 1 !important; }
.sg-admin-panel .booking-pill-btn, .sg-admin-dialog .booking-pill-btn { height: 56rpx !important; min-height: 56rpx !important; font-size: 22rpx !important; }
.sg-admin-panel .booking-page-btn { height: 44rpx !important; min-height: 44rpx !important; font-size: 20rpx !important; }
.sg-admin-dialog .booking-modal__head { flex-shrink: 0; padding-right: 0; margin-bottom: 24rpx; }
.sg-admin-dialog .booking-modal__close { flex: 0 0 52rpx; width: 52rpx; min-width: 52rpx; height: 52rpx; }
.sg-admin-close-icon { display: block; width: 28rpx; height: 28rpx; }
.sg-admin-close--active { opacity: .7; }
.sg-admin-dialog .booking-modal__submit { display: flex; align-items: center; justify-content: center; flex: none; width: 100% !important; min-width: 0 !important; height: 64rpx !important; min-height: 64rpx !important; padding: 0 !important; margin: 20rpx 0 0; line-height: 1 !important; background: #ffc857 !important; color: #5d4037 !important; }
.sg-admin-dialog .booking-modal__submit[disabled] { background: #ffc857 !important; color: #5d4037 !important; opacity: .5; }
.sg-admin-panel, .sg-admin-dialog, .booking-pill-btn, .booking-page-btn, .booking-modal__submit, .booking-modal__close { font-family: var(--font-default, "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif); }
.sg-admin-form-scroll { flex: 1; min-height: 0; max-height: calc(82vh - 206rpx); }
/* 用字段自身的留白衔接条件渲染内容，避免依赖跨 block 的 flex gap。 */
.sg-admin-form-body { display: block; overflow: visible; padding: 0 2rpx 0 0; }
.sg-admin-form-body .booking-modal__field { display: flex; flex-direction: column; gap: 0; margin-bottom: 24rpx; }
.sg-admin-form-body .booking-modal__field:last-child { margin-bottom: 0; }
.sg-admin-form-body .booking-modal__label { display: block; margin-bottom: 12rpx; line-height: 1.5; }
.sg-admin-form-body .booking-modal__input, .sg-admin-form-body .booking-modal__textarea { font-family: var(--font-default, "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif); }
.sg-admin-form-body .booking-modal__input { height: 78rpx; min-height: 78rpx; line-height: 78rpx; font-size: 22rpx; }
/* textarea 原生默认高度较大，显式固定初始高度，长信件在框内滚动。 */
.sg-admin-form-body .booking-modal__textarea { height: 200rpx; min-height: 200rpx; font-size: 22rpx; line-height: 1.55; }
.sg-admin-form-body .booking-modal__placeholder { font-size: 22rpx; color: rgba(93, 64, 55, .38); }
.sg-admin-select { display: flex; align-items: center; }
.sg-admin-select__value { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sg-admin-select__arrow { flex: none; width: 26rpx; height: 26rpx; margin-left: 12rpx; }
.sg-admin-setting { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; margin-bottom: 24rpx; }
.sg-admin-setting .booking-modal__label { margin-bottom: 0; }
.sg-admin-switch { transform: scale(.82); transform-origin: right center; }
.sg-admin-cover-preview { display: block; width: 100%; height: 220rpx; margin-bottom: 16rpx; border-radius: 18rpx; }
.sg-admin-avatar { display: block; width: 100rpx; height: 100rpx; margin-bottom: 16rpx; border-radius: 50%; }
.sg-admin-upload-row { display: flex; align-items: center; justify-content: flex-start; }
.sg-admin-dialog .sg-admin-upload { flex: none; margin: 0 !important; }
.sg-admin-error { color: #b42318; background: #fff1f0; border-radius: 12rpx; padding: 12rpx 16rpx; margin: 12rpx 0; font-size: 24rpx; }
