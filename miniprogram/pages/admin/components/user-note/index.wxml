<button class="user-admin-action user-admin-action--ghost note-edit" bindtap="openEditor" disabled="{{disabled || saving}}">编辑备注</button>
<root-portal wx:if="{{open}}">
  <view class="booking-modal-mask" bindtap="closeEditor">
    <view class="booking-modal booking-modal--form note-dialog" catchtap="stopTap">
      <view class="booking-modal__head">
        <text class="booking-modal__title">编辑用户备注</text>
        <view class="booking-modal__close" bindtap="closeEditor">✕</view>
      </view>
      <view class="booking-modal__body">
        <text class="note-name">用户：{{userName}}</text>
        <view class="booking-modal__field">
          <text class="booking-modal__label">管理员备注</text>
          <textarea class="booking-modal__textarea note-input" value="{{text}}" maxlength="500" bindinput="onInput" disabled="{{saving}}" placeholder="添加用户备注，仅管理员可见" placeholder-class="booking-modal__placeholder note-placeholder" cursor-spacing="80" />
          <view class="note-meta"><text>留空可清除备注</text><text>{{text.length}}/500</text></view>
        </view>
        <text wx:if="{{error}}" class="note-error">{{error}}</text>
        <view class="booking-confirm-modal__actions">
          <button class="booking-confirm-modal__btn booking-confirm-modal__btn--ghost note-button" bindtap="closeEditor" disabled="{{saving}}">取消</button>
          <button class="booking-confirm-modal__btn album-modal__btn--primary note-button" bindtap="saveNote" disabled="{{saving}}" loading="{{saving}}">保存备注</button>
        </view>
      </view>
    </view>
  </view>
</root-portal>
