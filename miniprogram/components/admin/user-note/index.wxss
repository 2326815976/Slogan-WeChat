.note-row { display: flex; gap: 20rpx; margin: 20rpx 0; font-size: 24rpx; }
.note-label { flex: none; color: #8d6e63; }
.note-value { min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; color: #5d4037; }
.note-edit, .note-save { background: #ffc857; color: #5d4037; }
.note-edit { margin: 0; padding: 14rpx 24rpx; border-radius: 18rpx; font-size: 24rpx; line-height: 1.4; }
button::after { border: none; }
.note-mask { position: fixed; inset: 0; z-index: 2200; background: rgba(44, 27, 17, .4); display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.note-dialog { width: 100%; max-width: 620rpx; box-sizing: border-box; padding: 32rpx; border-radius: 28rpx; background: #fffbf0; }
.note-title { display: block; color: #5d4037; font-size: 32rpx; font-weight: 700; }
.note-name { display: block; margin: 16rpx 0; font-size: 24rpx; color: #8d6e63; overflow-wrap: anywhere; }
.note-input { width: 100%; height: 240rpx; box-sizing: border-box; padding: 20rpx; border: 2rpx solid rgba(93, 64, 55, .2); border-radius: 16rpx; background: #fff; font-size: 28rpx; color: #5d4037; }
.note-meta { display: flex; justify-content: space-between; margin: 12rpx 0; font-size: 22rpx; color: #8d6e63; }
.note-error { display: block; margin: 12rpx 0; color: #b42318; font-size: 24rpx; }
.note-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.note-actions button { flex: 1; margin: 0; font-size: 26rpx; border-radius: 18rpx; }
.note-cancel { background: #f2e8d8; color: #5d4037; }
