/* root-portal 内的输入控件也沿用项目字体，避免回退到系统控件字体。 */
.note-edit,
.note-dialog,
.note-input,
.note-placeholder,
.note-button {
  font-family: var(--font-default, "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif);
}

.note-name {
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(93, 64, 55, 0.62);
  overflow-wrap: anywhere;
}

.note-input {
  height: 240rpx;
  flex-shrink: 0;
}

.note-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(93, 64, 55, 0.58);
}

.note-error {
  font-size: 22rpx;
  line-height: 1.5;
  color: #b42318;
}
