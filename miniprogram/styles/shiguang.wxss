/* 与 Web 拾光保持一致，复用原站奶油色、深棕与圆角按钮。 */
page{height:100%;background:#FFFBF0;color:#5D4037}
.sg-page{height:100vh;display:flex;flex-direction:column}.sg-scroll{flex:1;min-height:0}.sg-content{padding:32rpx 32rpx 64rpx;box-sizing:border-box}.sg-bottom-space{padding-bottom:200rpx}
.sg-card{background:white;border:2rpx solid #5d403733;border-radius:40rpx;padding:36rpx;margin-bottom:28rpx;box-shadow:5rpx 5rpx 0 #5d40371a;min-width:0;box-sizing:border-box}.sg-title{font-size:34rpx;font-weight:700;margin-bottom:16rpx;line-height:1.5}.sg-muted{font-size:24rpx;color:#8D6E63;line-height:1.8;word-break:break-all}.sg-text{font-size:28rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all;margin:20rpx 0}
.sg-row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.sg-between{justify-content:space-between}.sg-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.sg-grid .sg-card{margin-bottom:0}
.sg-button{display:inline-flex;align-items:center;justify-content:center;gap:12rpx;box-sizing:border-box;background:#FFC857;color:#5D4037;border:3rpx solid #5D4037;border-radius:28rpx;font-size:28rpx;font-weight:600;padding:16rpx 28rpx;margin:12rpx 0;min-height:84rpx;line-height:1.5;box-shadow:5rpx 5rpx 0 #5D4037}.sg-button::after{border:0}.sg-button:active{transform:translate(3rpx,3rpx);box-shadow:2rpx 2rpx 0 #5D4037}.sg-button[disabled]{opacity:.45;background:#FFC857;color:#5D4037}
.sg-link{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:76rpx;border:2rpx solid #5d403726;border-radius:999rpx;background:#FFFBF0;color:#5D4037;font-size:26rpx;padding:14rpx 22rpx;line-height:1.5}.sg-link:active{background:#FFF0C8}.sg-danger{color:#B45345;background:#FFF4F0;border-color:#b4534526}.sg-error{background:#FFF1ED;color:#A64234;border:2rpx solid #b4534526;padding:24rpx;border-radius:28rpx;margin-bottom:24rpx;line-height:1.7}.sg-note{background:#FFF5D9;color:#795548;border:2rpx dashed #d5ad54;padding:24rpx;border-radius:28rpx;margin:24rpx 0;line-height:1.8;font-size:24rpx}
.sg-input{background:#FFFBF0;border:3rpx solid #5d403726;border-radius:24rpx;box-sizing:border-box;width:100%;padding:20rpx 24rpx;margin:14rpx 0 28rpx;min-height:88rpx;font-size:28rpx;line-height:1.6}.sg-area{min-height:200rpx;height:240rpx}.sg-label{font-size:26rpx;font-weight:500;margin-top:12rpx}.sg-avatar{width:112rpx;height:112rpx;border:5rpx solid #fff;box-shadow:0 0 0 2rpx #5d403726;border-radius:50%;background:#FFF0D4;box-sizing:border-box;flex-shrink:0}.sg-cover{width:100%;height:300rpx;border-radius:28rpx}.sg-center{text-align:center}.sg-member{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:16rpx}.sg-member .sg-link{font-size:22rpx;min-height:64rpx}.sg-member text.sg-avatar{display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#B45345}.sg-small-image{width:200rpx;height:160rpx;border-radius:24rpx}.sg-divider{border-top:2rpx dashed #5d403726;padding-top:28rpx;margin-top:24rpx}.sg-chip{display:inline-block;font-size:24rpx;background:#FFF0D4;padding:8rpx 20rpx;border-radius:999rpx}
.sg-hero{padding:0;overflow:hidden}.sg-hero .sg-cover{display:block;height:340rpx;border-radius:0}.sg-members{padding:32rpx 20rpx;background:#FFFEF9;display:flex;gap:16rpx}.sg-letter{background:#FFF8E7;border-style:dashed;box-shadow:none}.sg-letter .sg-title{margin-bottom:0}.sg-module{padding:28rpx}.sg-module .sg-title{font-size:30rpx;margin:20rpx 0 8rpx}.sg-module-icon{width:80rpx;height:80rpx;border-radius:24rpx;background:#FFF0C8;color:#795548;display:flex;align-items:center;justify-content:center;font-size:40rpx}.sg-module:nth-child(3n+2) .sg-module-icon{background:#FCE5E0}.sg-module:nth-child(3n) .sg-module-icon{background:#E7EEDC}.sg-module-id{font-size:20rpx;line-height:1.5;margin-top:12rpx}
