page{height:100%;background:#FFFBF0;color:#5D4037}.sg-page{height:100vh;display:flex;flex-direction:column}.sg-scroll{flex:1;min-height:0}.sg-content{padding:32rpx 28rpx 60rpx;box-sizing:border-box}.sg-bottom-space{padding-bottom:200rpx}.sg-card{background:white;border:1px solid #5d40371c;border-radius:32rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 32rpx #5d403707}.sg-title{font-size:34rpx;font-weight:700;margin-bottom:16rpx}.sg-muted{font-size:24rpx;color:#8D6E63;line-height:1.8}.sg-text{font-size:28rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all;margin:16rpx 0}.sg-row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.sg-between{justify-content:space-between}.sg-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.sg-grid .sg-card{margin-bottom:0}.sg-button{background:#FFC857;color:#5D4037;border-radius:20rpx;font-size:28rpx;padding:4rpx 24rpx;margin:8rpx 0;min-height:80rpx}.sg-button::after{border:0}.sg-link{color:#945025;font-size:26rpx;padding:16rpx 8rpx}.sg-danger{color:#B45345}.sg-error{background:#fff1ed;color:#B45345;padding:24rpx;border-radius:20rpx;margin-bottom:24rpx}.sg-input{background:#FFFBF0;border:1px solid #5d40372b;border-radius:20rpx;box-sizing:border-box;width:100%;padding:20rpx;margin:12rpx 0 24rpx;min-height:80rpx;font-size:28rpx}.sg-area{min-height:180rpx;height:220rpx}.sg-label{font-size:26rpx}.sg-avatar{width:112rpx;height:112rpx;border-radius:50%;background:#FFEBC8}.sg-cover{width:100%;height:300rpx;border-radius:24rpx}.sg-center{text-align:center}.sg-member{flex:1;display:flex;align-items:center;flex-direction:column;gap:12rpx}.sg-small-image{width:200rpx;height:160rpx;border-radius:16rpx}.sg-divider{border-top:1px solid #5d40371c;padding-top:20rpx;margin-top:16rpx}.sg-chip{font-size:24rpx;background:#FFF2D6;padding:8rpx 16rpx;border-radius:16rpx}
