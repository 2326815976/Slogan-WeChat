/* 与 Web 拾光保持一致，复用原站奶油色、深棕与圆角按钮。 */
page{height:100%;background:#FFFBF0;color:#5D4037}
.sg-page{height:100vh;display:flex;flex-direction:column}.sg-scroll{flex:1;min-height:0}.sg-content{padding:32rpx 32rpx 64rpx;box-sizing:border-box}.sg-bottom-space{padding-bottom:200rpx}
.sg-card{background:#fffdf8;border:2rpx solid #ecdfcc;border-radius:32rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 6rpx 18rpx rgba(167,114,75,.08);min-width:0;box-sizing:border-box}.sg-title{font-size:32rpx;font-weight:700;margin-bottom:12rpx;line-height:1.4}.sg-muted{font-size:24rpx;color:#806454;line-height:1.7;overflow-wrap:anywhere}.sg-text{font-size:28rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;margin:16rpx 0}
.sg-row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.sg-between{justify-content:space-between}.sg-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.sg-grid .sg-card{margin-bottom:0}
.sg-button{display:inline-flex;align-items:center;justify-content:center;gap:12rpx;box-sizing:border-box;width:auto;min-width:0;max-width:100%;background:#ffd894;color:#5d4037;border:2rpx solid #efc076;border-radius:22rpx;font-size:28rpx;font-weight:600;padding:14rpx 24rpx;margin:12rpx 0;min-height:76rpx;line-height:1.4}.sg-button::after{border:0}.sg-button:active{background:#f8cc83}.sg-button[disabled]{opacity:.5;background:#ffd894;color:#5d4037}
.sg-link{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:76rpx;border:2rpx solid #5d403726;border-radius:999rpx;background:#FFFBF0;color:#5D4037;font-size:26rpx;padding:14rpx 22rpx;line-height:1.5}.sg-link:active{background:#FFF0C8}.sg-danger{color:#B45345;background:#FFF4F0;border-color:#b4534526}.sg-error{background:#FFF1ED;color:#A64234;border:2rpx solid #b4534526;padding:24rpx;border-radius:28rpx;margin-bottom:24rpx;line-height:1.7}.sg-note{background:#FFF5D9;color:#795548;border:2rpx dashed #d5ad54;padding:24rpx;border-radius:28rpx;margin:24rpx 0;line-height:1.8;font-size:24rpx}
.sg-input{background:#fffdf8;border:2rpx solid #e6d6c2;border-radius:20rpx;box-sizing:border-box;width:100%;min-width:0;padding:16rpx 20rpx;margin:12rpx 0 20rpx;min-height:80rpx;font-size:28rpx;line-height:1.5}.sg-area{min-height:156rpx;height:180rpx}.sg-label{font-size:26rpx;font-weight:500;margin-top:12rpx}.sg-avatar{width:112rpx;height:112rpx;border:5rpx solid #fff;box-shadow:0 0 0 2rpx #5d403726;border-radius:50%;background:#FFF0D4;box-sizing:border-box;flex-shrink:0}.sg-cover{width:100%;height:300rpx;border-radius:28rpx}.sg-center{text-align:center}.sg-member{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:16rpx}.sg-member .sg-link{font-size:22rpx;min-height:64rpx}.sg-member text.sg-avatar{display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#B45345}.sg-small-image{width:200rpx;height:160rpx;border-radius:24rpx}.sg-divider{border-top:2rpx dashed #5d403726;padding-top:24rpx;margin-top:20rpx}.sg-chip{display:inline-block;font-size:24rpx;background:#FFF0D4;padding:8rpx 20rpx;border-radius:999rpx}
.sg-hero{padding:0;overflow:hidden}.sg-hero .sg-cover{display:block;height:340rpx;border-radius:0}.sg-members{padding:32rpx 20rpx;background:#FFFEF9;display:flex;gap:16rpx}.sg-letter{background:#FFF8E7;border-style:dashed;box-shadow:none}.sg-letter .sg-title{margin-bottom:0}.sg-module{padding:28rpx}.sg-module .sg-title{font-size:30rpx;margin:20rpx 0 8rpx}.sg-module-icon{width:80rpx;height:80rpx;border-radius:24rpx;background:#FFF0C8;color:#795548;display:flex;align-items:center;justify-content:center;font-size:40rpx}.sg-module:nth-child(3n+2) .sg-module-icon{background:#FCE5E0}.sg-module:nth-child(3n) .sg-module-icon{background:#E7EEDC}.sg-module-id{font-size:20rpx;line-height:1.5;margin-top:12rpx}
