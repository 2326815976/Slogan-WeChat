.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 8rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 251, 240, 0.95);
  border-top: 4rpx dashed rgba(93, 64, 55, 0.15);
  box-shadow: 0 -4rpx 24rpx rgba(93, 64, 55, 0.08);
  z-index: 999;
  box-sizing: border-box;
}

.tab-inner {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  height: 100rpx;
  padding: 0 8rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  overflow: hidden;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.tab-item--active { opacity: 0.8; }

.tab-glow {
  position: absolute;
  top: 0;
  left: 50%;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  background: rgba(255, 200, 87, 0.3);
  border-radius: 999rpx;
  filter: blur(16px);
  pointer-events: none;
  animation: tab-glow-in 0.3s ease-out both;
}

.tab-icon {
  display: block;
  flex: none;
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  pointer-events: none;
}

.tab-icon--active { filter: drop-shadow(0 4rpx 8rpx rgba(255, 200, 87, 0.3)); }

.tab-text {
  position: relative;
  z-index: 1;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 500;
  color: rgba(93, 64, 55, 0.6);
  pointer-events: none;
  transition: color 0.2s ease;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tab-text--active {
  color: #ffc857;
  font-weight: 700;
}

@keyframes tab-glow-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
